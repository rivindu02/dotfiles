[Desktop Entry]
Type=Application
Name=Master PDF Editor
GenericName=PDF Editor
Comment=Edit your PDF and XPS files
Exec=/usr/bin/env XCURSOR_THEME=Bibata-Modern-Classic XCURSOR_SIZE=24 QT_QPA_PLATFORM=wayland QT_WAYLAND_DISABLE_WINDOWDECORATION=1 QT_QPA_PLATFORMTHEME=qt5ct GTK_THEME=Gruvbox-Material-Dark QT_ENABLE_HIGHDPI_SCALING=1 QT_SCALE_FACTOR_ROUNDING_POLICY=PassThrough /opt/master-pdf-editor-4/masterpdfeditor4 %f
Icon=/opt/master-pdf-editor-4/masterpdfeditor4.png
Categories=Office;Publishing;
MimeType=application/pdf;
