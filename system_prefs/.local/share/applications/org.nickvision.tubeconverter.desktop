[Desktop Entry]
Version=1.0
Name=Parabolic
Comment=Download web video and audio
Exec=/home/rivindu02/.local/bin/org.nickvision.tubeconverter %u
Icon=org.nickvision.tubeconverter
Terminal=false
Type=Application
