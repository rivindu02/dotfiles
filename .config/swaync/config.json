{
  "$schema": "/etc/xdg/swaync/configSchema.json",
  "notification-inline-replies": true,
  "notification-2fa-action": true,
  "hide-on-clear": false,
  "hide-on-action": true,
  "keyboard-shortcuts": true,
  "timeout": 5,
  "timeout-low": 2,
  "timeout-critical": 5,
  "widgets": [
    "title",
    "label#weather",
    "label#gcal-header",
    "label#gcal-today-header",
    "label#gcal-today-timed",
    "label#gcal-tomorrow-header",
    "label#gcal-tomorrow-timed",
    "mpris",
    "notifications",
    "dnd"
  ],
  "widget-config": {
    "title": {
      "text": "Notifications",
      "clear-all-button": true,
      "button-text": "󰃯 Clear All"
    },
    "dnd": {
      "text": "Do Not Disturb"
    },
    "mpris": {
      "show-album-art": "when-available",
      "autohide": true
    },
    "label#gcal-header": {
      "text": "",
      "markup": false
    },
    "label#gcal-today-header": {
      "text": "",
      "markup": false
    },
    "label#gcal-today-allday": {
      "text": "",
      "markup": false
    },
    "label#gcal-today-timed": {
      "text": "",
      "markup": false
    },
    "label#gcal-tomorrow-header": {
      "text": "",
      "markup": false
    },
    "label#gcal-tomorrow-allday": {
      "text": "",
      "markup": false
    },
    "label#gcal-tomorrow-timed": {
      "text": "",
      "markup": false
    },
    "label#gcal-day3-header": {
      "text": "",
      "markup": false
    },
    "label#gcal-day3-allday": {
      "text": "",
      "markup": false
    },
    "label#gcal-day3-timed": {
      "text": "",
      "markup": false
    },
    "label#weather": {
      "text": "",
      "markup": false
    }
  },
  "notification-visibility": {
    "media-player": {
      "state": "ignored",
      "app-name": ".*player.*|.*mpris.*|.*spotify.*|.*firefox.*|.*brave.*|.*chromium.*"
    },
    "remind-silent": {
      "state": "muted",
      "app-name": "^remind-silent$"
    }
  }
}
