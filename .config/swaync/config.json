{
  "$schema": "/etc/xdg/swaync/configSchema.json",
  "notification-inline-replies": true,
  "notification-2fa-action": true,
  "hide-on-clear": false,
  "hide-on-action": true,
  "keyboard-shortcuts": true,
  "timeout": 5,
  "timeout-low": 2,
  "timeout-critical": 0,
  "widgets": [
    "title",
    "label#weather",
    "label#gcal-header",
    "label#gcal-today-header",
    "label#gcal-today-timed",
    "mpris",
    "notifications",
    "dnd"
  ],
  "widget-config": {
    "title": {
      "text": "Notifications",
      "clear-all-button": true,
      "button-text": "󰃯 Clear All"
    },
    "dnd": {
      "text": "Do Not Disturb"
    },
    "mpris": {
      "show-album-art": "when-available",
      "autohide": true
    },
    "label#gcal-header": {
      "text": "󰃭  Upcoming Events",
      "markup": false
    },
    "label#gcal-today-header": {
      "text": " Today",
      "markup": false
    },
    "label#gcal-today-allday": {
      "text": "󰃰 try to make volume, brightness controller 2026-08-28.md",
      "markup": false
    },
    "label#gcal-today-timed": {
      "text": "19:15  •  do the service for laptop",
      "markup": false
    },
    "label#gcal-tomorrow-header": {
      "text": " Tomorrow",
      "markup": false
    },
    "label#gcal-tomorrow-allday": {
      "text": "󰃰 Nikini Full Moon Poya Day",
      "markup": false
    },
    "label#gcal-tomorrow-timed": {
      "text": "12:00  •  try to make volume, brightness controller 2026-08-28.md\n13:15  •  train a model in github 2026-08-26.md\n16:00  •  do the service for laptop",
      "markup": false
    },
    "label#gcal-day3-header": {
      "text": " Sun Aug 30",
      "markup": false
    },
    "label#gcal-day3-allday": {
      "text": "󰃰 train a model in github 2026-08-26.md",
      "markup": false
    },
    "label#gcal-day3-timed": {
      "text": "10:15  •  Deep learning for vision\n13:15  •  Neural Networks and Fuzzy Logic",
      "markup": false
    },
    "label#weather": {
      "text": "🌦️  31°C  Home  ·  🌦️  30°C  University",
      "markup": false
    }
  },
  "notification-visibility": {
    "media-player": {
      "state": "ignored",
      "app-name": ".*player.*|.*mpris.*|.*spotify.*|.*firefox.*|.*brave.*|.*chromium.*"
    },
    "remind-silent": {
      "state": "muted",
      "app-name": "^remind-silent$"
    }
  }
}