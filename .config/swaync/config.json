{
  "$schema": "/etc/xdg/swaync/configSchema.json",
  "notification-inline-replies": true,
  "notification-2fa-action": true,
  "hide-on-clear": false,
  "hide-on-action": true,
  "keyboard-shortcuts": true,
  "timeout": 5,
  "timeout-low": 2,
  "timeout-critical": 0,
  "widgets": [
    "title",
    "label#gcal-header",
    "label#gcal-events",
    "mpris",
    "notifications",
    "dnd"
  ],
  "widget-config": {
    "title": {
      "text": "Notifications",
      "clear-all-button": true,
      "button-text": "󰃯 Clear All"
    },
    "dnd": {
      "text": "Do Not Disturb"
    },
    "label#gcal-header": {
      "text": "󰃭 Upcoming Events",
      "markup": false
    },
    "label#gcal-events": {
      "text": "Today 09:30  •  P8 Proudct Standup\nTomorrow 09:30  •  P8 Proudct Standup\nTomorrow 10:00  •  AI code analysis\nTomorrow 10:00  •  P8 Product Sprint Retrospect…\nWed Apr 29 09:30  •  P8 Proudct Standup",
      "markup": false
    },
    "mpris": {
      "show-album-art": "when-available",
      "autohide": true
    }
  },
  "notification-visibility": {
    "media-player": {
      "state": "ignored",
      "app-name": ".*player.*|.*mpris.*|.*spotify.*|.*firefox.*|.*brave.*|.*chromium.*"
    }
  }
}