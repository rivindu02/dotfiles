{
  "$schema": "/etc/xdg/swaync/configSchema.json",
  "notification-inline-replies": true,
  "notification-2fa-action": true,
  "hide-on-clear": false,
  "hide-on-action": true,
  "keyboard-shortcuts": true,
  "timeout": 5,
  "timeout-low": 2,
  "timeout-critical": 0,
  "widgets": [
    "title",
    "label#gcal-header",
    "mpris",
    "notifications",
    "dnd"
  ],
  "widget-config": {
    "title": {
      "text": "Notifications",
      "clear-all-button": true,
      "button-text": "󰃯 Clear All"
    },
    "dnd": {
      "text": "Do Not Disturb"
    },
    "mpris": {
      "show-album-art": "when-available",
      "autohide": true
    },
    "label#gcal-header": {
      "text": "󰃭  No upcoming events",
      "markup": false
    },
    "label#gcal-today-header": {
      "text": " Today",
      "markup": false
    },
    "label#gcal-today-allday": {
      "text": "󰃰 check temu",
      "markup": false
    },
    "label#gcal-today-timed": {
      "text": "08:30  •  Create Viva peresntation",
      "markup": false
    },
    "label#gcal-tomorrow-header": {
      "text": " Tomorrow",
      "markup": false
    },
    "label#gcal-tomorrow-allday": {
      "text": "󰃰 check temu",
      "markup": false
    },
    "label#gcal-tomorrow-timed": {
      "text": "08:30  •  Create Viva peresntation",
      "markup": false
    },
    "label#gcal-day3-header": {
      "text": " Tue Jun 09",
      "markup": false
    },
    "label#gcal-day3-allday": {
      "text": "󰃰 RemoteOK",
      "markup": false
    },
    "label#gcal-day3-timed": {
      "text": "",
      "markup": false
    }
  },
  "notification-visibility": {
    "media-player": {
      "state": "ignored",
      "app-name": ".*player.*|.*mpris.*|.*spotify.*|.*firefox.*|.*brave.*|.*chromium.*"
    }
  }
}