vim.g.floaterm_keymap_next   = "<F9>"
vim.g.floaterm_keymap_toggle = "<F12>"

vim.api.nvim_create_autocmd("FileType", {
  pattern = "python",
  callback = function()
    map("n", "<F5>", "<cmd>w<CR><cmd>FloatermNew --autoclose=0 python3 %<CR>", { buffer = true })
  end,
})
vim.api.nvim_create_autocmd("FileType", {
  pattern = "java",
  callback = function()
    map("n", "<F5>", "<cmd>w<CR><cmd>FloatermNew --autoclose=0 mvn clean compile<CR>", { buffer = true })
  end,
})

