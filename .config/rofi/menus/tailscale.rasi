configuration {
    show-icons: false;
    matching: "fuzzy";
    scroll-method: 0;
}

* {
    font: "Caskaydia Mono Nerd Font Propo 13";
    background-color: transparent;
    text-color: #d4be98;
    border-color: #504945;
}

window {
    width: 660px;
    location: center;
    anchor: center;
    background-color: #282828f5;
    border: 1px solid;
    border-color: #89b482;
    border-radius: 10px;
}

mainbox {
    padding: 24px;
    spacing: 18px;
    children: [ inputbar, message, listview ];
}

inputbar {
    spacing: 16px;
    children: [ prompt, entry ];
}

prompt {
    font: "Caskaydia Mono Nerd Font Propo Bold 19";
    text-color: #89b482;
}

entry {
    placeholder: "Filter devices…";
    placeholder-color: #928374;
    vertical-align: 0.5;
}

message { padding: 0 0 6px 0; }
textbox { text-color: #928374; markup: true; }

listview {
    lines: 9;
    fixed-height: false;
    dynamic: true;
    scrollbar: true;
    spacing: 6px;
}

element {
    padding: 13px 14px;
    border-radius: 10px;
    children: [ element-text ];
}

element selected.normal {
    background-color: #3c4540;
    text-color: #ebdbb2;
}

element normal.urgent, element selected.urgent {
    padding: 7px 14px;
    background-color: transparent;
}

scrollbar {
    width: 3px;
    handle-width: 3px;
    handle-color: #89b482;
    background-color: #32302f;
    border-radius: 3px;
}

element-text {
    vertical-align: 0.5;
    highlight: bold;
}

error-message { padding: 20px; }
