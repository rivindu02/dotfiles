/* Type 2: searchable icon tiles using the shared desktop theme. */
@import "~/.config/rofi/shared/base.rasi"

configuration { show-icons: false; }
window { width: 600px; }
entry { placeholder: "Search power actions…"; }
listview {
    columns: 5;
    lines: 1;
    fixed-height: true;
    fixed-columns: true;
    dynamic: true;
    scrollbar: false;
    spacing: 8px;
}
element { padding: 26px 8px; }
element normal.normal, element alternate.normal {
    background-color: @background-alt;
}
element-text {
    font: "Caskaydia Mono Nerd Font Propo 30";
    horizontal-align: 0.5;
    vertical-align: 0.5;
    highlight: none;
}
