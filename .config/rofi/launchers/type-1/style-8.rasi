@import "~/.config/rofi/shared/base.rasi"

configuration {
    modi: "drun,combi,filebrowser,window";
    combi-modi: "drun,run,filebrowser,window";
    show-icons: true;
    display-drun: " Apps";
    display-combi: " All";
    display-filebrowser: " Files";
    display-window: " Windows";
    drun-display-format: "{name}";
    drun-match-fields: "name";
    window-format: "{w} · {c} · {t}";
}
mainbox { children: [ "inputbar", "mode-switcher", "message", "listview" ]; }
entry { placeholder: "Search apps, commands, files…"; }
