#!/bin/bash
# screenshot [full] — area (default) or full-screen capture, saved and copied.
# Clicking the notification (popup or panel) previews the image in swayimg:
# swaync runs ~/.config/scripts/notify-open.sh with the filepath hint.
# The "Edit" button opens satty (img-edit) while the popup is showing.

FILE=~/Pictures/Screenshots/$(date +%Y-%m-%d_%H-%M-%S).png

if [[ "$1" == "full" ]]; then
    grim "$FILE" || exit 0
    body="Saved & copied to clipboard"
else
    if ! grim -g "$(slurp)" "$FILE"; then
        rm -f "$FILE"
        exit 0
    fi
    body="Selected area saved & copied to clipboard"
fi

wl-copy < "$FILE"

# swaync can't tell which action was clicked, so only this listener sees "edit".
# It leaves a marker so notify-open.sh skips the preview. notify-send stops
# listening when the popup times out; after that, clicks only preview.
(
    action=$(notify-send -a "Screenshot" "Screenshot" "$body" -i "$FILE" -t 5000 \
        -h "string:filepath:$FILE" -A "default=Preview" -A "edit=Edit")
    if [[ "$action" == "edit" ]]; then
        touch "$XDG_RUNTIME_DIR/notify-edit-${FILE##*/}"
        ~/.local/bin/img-edit "$FILE"
    fi
) >/dev/null 2>&1 &
disown
