#!/usr/bin/env bash

source "$HOME/.config/rofi/scripts/toggle.sh"
rofi_toggle || exit 0
# --- Config ---
ROFI_THEME="$HOME/.config/rofi/menus/search.rasi"

PLATFORMS=(
    "󰊭  DuckDuckGo"
    "󱜙  ChatGPT"
    "󰭎  Claude"
    "󰗃  YouTube"
)

# First rofi: pick platform OR type a search query (platforms pinned at top)
result=$(printf '%s\n' "${PLATFORMS[@]}" | rofi \
    -dmenu -i \
    -p "Search" \
    -mesg "Pick a platform" \
    -theme "$ROFI_THEME")

[ -z "$result" ] && exit 0

# Check if the result matches one of the platform entries
matched_platform=""
for p in "${PLATFORMS[@]}"; do
    if [ "$result" = "$p" ]; then
        matched_platform="$p"
        break
    fi
done

if [ -z "$matched_platform" ]; then
    # User typed a query directly — use the selected browser.
    encoded=$(python3 -c "import urllib.parse,sys; print(urllib.parse.quote(sys.argv[1]))" "$result")
    "$HOME/.local/bin/default-browser" "https://duckduckgo.com/?q=$encoded"
    exit 0
fi

# Per-platform border color for the query prompt
case "$matched_platform" in
    *DuckDuckGo*) border_color="#DE5833" ;; # duckduckgo orange
    *ChatGPT*) border_color="#10A37F" ;;   # openai green
    *Claude*)  border_color="#D79921" ;;   # yellow
    *YouTube*) border_color="#FB4934" ;;   # red
esac

# User picked a platform — second rofi for the query
query=$(rofi \
    -dmenu -i \
    -p "Query" \
    -theme "$ROFI_THEME" \
    -theme-str "window { border-color: ${border_color}; } mainbox { children: [ \"inputbar\", \"message\" ]; }")
[ -z "$query" ] && exit 0

encoded=$(python3 -c "import urllib.parse,sys; print(urllib.parse.quote(sys.argv[1]))" "$query")

case "$matched_platform" in
    *DuckDuckGo*)
        "$HOME/.local/bin/default-browser" "https://duckduckgo.com/?q=$encoded" ;;
    *ChatGPT*)
        "$HOME/.local/bin/default-browser" "https://chatgpt.com/?q=$encoded" ;;
    *Claude*)
        "$HOME/.local/bin/default-browser" "https://claude.ai/new?q=$encoded" ;;
    *YouTube*)
        "$HOME/.local/bin/default-browser" "https://www.youtube.com/results?search_query=$encoded" ;;
esac

