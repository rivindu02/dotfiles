#!/bin/bash

source "$HOME/.config/rofi/scripts/toggle.sh"
rofi_toggle || exit 0
# Super+P changes only the live mirror relationship; hyprmoncfg owns the layout.
set -euo pipefail

runtime="${XDG_RUNTIME_DIR:-/tmp}/presentation-$UID"
mkdir -p "$runtime"
chmod 700 "$runtime"
exec 9>"$runtime/lock"
flock -n 9 || exit 0

notify() { notify-send -i video-display -t 3000 "Display" "$1"; }
monitors=$(hyprctl monitors all -j) || { notify "Cannot read displays from Hyprland"; exit 1; }
# Ignore disabled and virtual outputs. Mirrored physical displays remain included.
monitors=$(jq '[.[] | select(.disabled != true) | select(.name | test("^(HEADLESS|FALLBACK|WL-|X11-)") | not)]' <<< "$monitors")
active=0
if jq -e 'any(.[]; (.mirrorOf // "none") != "none" and (.mirrorOf // "") != "")' <<< "$monitors" >/dev/null; then
    active=1
fi
choice=$(printf 'Extend desktop\nMirror\n' | rofi -dmenu -i -p "Display" \
    -pid "$runtime/rofi.pid" \
    -theme "$HOME/.config/rofi/menus/presentation.rasi" \
    -no-custom -no-fixed-num-lines -no-auto-select -format i \
    -selected-row "$active" -a "$active" -kb-cancel 'Escape,Super+p') || exit 0
[[ "$choice" == 0 || "$choice" == 1 ]] || exit 0

# Re-read after selection in case a cable was unplugged while the menu was open.
monitors=$(hyprctl monitors all -j)
monitors=$(jq '[.[] | select(.disabled != true) | select(.name | test("^(HEADLESS|FALLBACK|WL-|X11-)") | not)]' <<< "$monitors")
if (( $(jq length <<< "$monitors") < 2 )); then
    notify "Connect an external display to extend or mirror"
    exit 0
fi
managed="$HOME/.config/hypr/hyprmoncfg-monitors.lua"
if [[ ! -r "$managed" ]]; then
    notify "hyprmoncfg monitor configuration is missing; configure a layout there first"
    exit 1
fi

# Pass connector names and current settings as Lua tables, never shell commands.
live=$(jq -r 'map("{name=" + (.name|@json) + ",description=" + (.description|@json) + ",mode=" + ((.width|tostring)+"x"+(.height|tostring)+"@"+(.refreshRate|tostring)|@json) + ",position=" + ((.x|tostring)+"x"+(.y|tostring)|@json) + ",scale=" + (.scale|tostring) + ",transform=" + (.transform|tostring) + "}") | "{" + join(",") + "}"' <<< "$monitors")
config_path=$(jq -Rn --arg path "$managed" '$path')
code=$(cat <<LUA
local live = $live
local mirroring = $choice == 1
local rules = {}
-- Read the manager's latest output rules without changing workspaces or files.
local env = setmetatable({hl = {
    monitor = function(rule) rules[#rules + 1] = rule end,
    workspace_rule = function() end,
}}, {__index = _G})
local chunk, err
if setfenv then
    chunk, err = loadfile($config_path)
    if chunk then setfenv(chunk, env) end
else
    chunk, err = loadfile($config_path, "t", env)
end
assert(chunk, err)
chunk()
local source = live[1].name
for _, screen in ipairs(live) do
    if screen.name:match("^eDP") or screen.name:match("^LVDS") then source = screen.name; break end
end
for _, screen in ipairs(live) do
    local rule
    for _, saved in ipairs(rules) do
        local output = saved.output or ""
        if output == "" or output == screen.name or
            (output:sub(1, 5) == "desc:" and screen.description:sub(1, #output - 5) == output:sub(6)) then
            rule = {}
            for key, value in pairs(saved) do rule[key] = value end
        end
    end
    -- Unfamiliar projectors retain their working mode and use automatic placement.
    if not rule then
        rule = {mode = screen.mode, position = "auto", scale = screen.scale, transform = screen.transform}
    end
    if not mirroring and rule.mirror and rule.mirror ~= "" then rule.position = "auto" end
    rule.output = screen.name
    rule.disabled = false
    rule.mirror = mirroring and screen.name ~= source and source or ""
    hl.monitor(rule)
end
LUA
)
result=$(hyprctl eval "$code" 2>&1) || { notify "Could not apply display mode: $result"; exit 1; }
if [[ "$result" != ok ]]; then
    notify "Could not apply display mode: $result"
    exit 1
fi
if [[ "$choice" == 0 ]]; then
    notify "Extended desktop using hyprmoncfg layout"
else
    notify "Mirroring enabled (temporary)"
fi
