#!/usr/bin/env bash
# --- Config ---
ROFI_THEME="$HOME/.config/rofi/menus/psearch.rasi"

query=$(rofi \
    -dmenu \
    -p "Search" \
    -theme "$ROFI_THEME")

[ -z "$query" ] && exit 0

encoded=$(python3 -c "import urllib.parse,sys; print(urllib.parse.quote(sys.argv[1]))" "$query")

brave --incognito "https://search.brave.com/search?q=$encoded" 2>/dev/null
