#!/usr/bin/env bash

source "$HOME/.config/rofi/scripts/toggle.sh"
rofi_toggle || exit 0
# --- Config ---
ROFI_THEME="$HOME/.config/rofi/menus/psearch.rasi"

query=$(rofi \
    -dmenu -i \
    -p "Search" \
    -theme "$ROFI_THEME")

[ -z "$query" ] && exit 0

encoded=$(python3 -c "import urllib.parse,sys; print(urllib.parse.quote(sys.argv[1]))" "$query")

"$HOME/.local/bin/default-browser" --private "https://duckduckgo.com/?q=$encoded"
