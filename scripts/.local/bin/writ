#!/usr/bin/env bash
# --- Config ---
NOTES_DIR="$HOME/Documents/QuickNotes"
EDITOR_CMD="nvim"
ROFI_THEME="$HOME/.config/rofi/launchers/type-1/style.rasi"
mkdir -p "$NOTES_DIR"

# List notes (strip .md)
options=$(ls "$NOTES_DIR" 2>/dev/null | sed 's/\.md$//')

# Rofi Menu
choice=$(echo "$options" | rofi \
	-dmenu \
	-i \
	-p "Writ" \
	-theme "$ROFI_THEME")

[ -z "$choice" ] && exit 0

NOTE_PATH="$NOTES_DIR/$choice.md"

if [ ! -f "$NOTE_PATH" ]; then
	# Typed something that doesn't exist — confirm creation
	confirm=$(echo -e "Yes\nNo" | rofi \
		-dmenu \
		-p "New?" \
		-mesg "Create a new Writ '$choice'?" \
		-theme "$ROFI_THEME")
	[ "$confirm" != "Yes" ] && exit 0
fi

ghostty --class=writ_float -e "$EDITOR_CMD" "$NOTE_PATH" 2>/dev/null
