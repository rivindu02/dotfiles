#!/usr/bin/env bash

source "$HOME/.config/rofi/scripts/toggle.sh"
rofi_toggle || exit 0

## Author : Aditya Shakya (adi1090x)
## Modified for Hyprland 

# Current Theme
dir="$HOME/.config/rofi/powermenu/type-2"
theme='style-1'

# CMDs
uptime="`uptime -p | sed -e 's/up //g'`"
host=`hostname`

# Options
shutdown='⏻'
reboot='󰓦'
lock=''
suspend=''
logout=''
yes=''
no=''

# Rofi CMD
rofi_cmd() {
    rofi -dmenu -i -no-custom -no-sort \
        -display-columns 1 -display-column-separator '\t' \
        -p '⏻' \
        -mesg "Uptime: $uptime" \
        -theme ${dir}/${theme}.rasi \
        -no-auto-select
}

# Stay-awake state (see ~/.config/scripts/toggle-idle.sh)
stay_awake_pid="${XDG_RUNTIME_DIR:-/tmp}/stay-awake.pid"

# Confirmation CMD: $1 = message, $2 = window width, $3 = highlight colour
confirm_cmd() {
    rofi -theme-str "window {location: center; anchor: center; fullscreen: false; width: ${2:-250px};}" \
        -theme-str "element selected.normal {background-color: var(${3:-selected});}" \
        -theme-str 'mainbox {children: [ "message", "listview" ];}' \
        -theme-str 'listview {columns: 2; lines: 1;}' \
        -theme-str 'element-text {horizontal-align: 0.5;}' \
        -theme-str 'textbox {horizontal-align: 0.5;}' \
        -dmenu -i -no-custom -no-sort -selected-row 1 \
        -kb-custom-1 'y,Shift+y' -kb-custom-2 'n,Shift+n' \
        -p 'Confirmation' \
        -mesg "${1:-Are you Sure?}"$'\nY / N' \
        -no-auto-select \
        -theme ${dir}/${theme}.rasi
}

# Ask for confirmation. While stay-awake is on, say so: Yes turns it off first.
confirm_exit() {
    if [[ -f "$stay_awake_pid" ]]; then
        echo -e "$yes\n$no" | confirm_cmd '󰛊 Stay-awake is on. Sure?' 300px urgent
    else
        echo -e "$yes\n$no" | confirm_cmd
    fi
}

# Pass variables to rofi dmenu
run_rofi() {
    # Only the icon column is displayed; both columns are searchable.
    printf '%s\t%s\n' \
        "$lock" 'lock screen secure' \
        "$suspend" 'suspend sleep' \
        "$logout" 'logout log out sign out exit' \
        "$reboot" 'reboot restart' \
        "$shutdown" 'shutdown shut down poweroff power off' | rofi_cmd
}

# Execute Command
run_cmd() {
    local selected result
    selected="$(confirm_exit)"
    result=$?
    # Rofi custom keys return 10 for Y and 11 for N.
    if (( result != 10 )); then
        (( result == 0 )) && [[ "$selected" == "$yes" ]] || exit 0
    fi
    # Release the idle/sleep inhibitor, or suspend is refused
    [[ -f "$stay_awake_pid" ]] && "$HOME/.config/scripts/toggle-idle.sh"
    if [[ $1 == '--shutdown' ]]; then
        systemctl poweroff
    elif [[ $1 == '--reboot' ]]; then
        systemctl reboot
    elif [[ $1 == '--suspend' ]]; then
        systemctl suspend
    elif [[ $1 == '--logout' ]]; then
        hyprctl dispatch 'hl.dsp.exit()'
    fi
}

# Actions
chosen="$(run_rofi)"
chosen="${chosen%%$'\t'*}"

[[ -z "$chosen" ]] && exit 0

case ${chosen} in
    "$shutdown")
        run_cmd --shutdown
        ;;
    "$reboot")
        run_cmd --reboot
        ;;
    "$lock")
        systemctl --user start hyprlock.service
        ;;
    "$suspend")
        run_cmd --suspend
        ;;
    "$logout")
        run_cmd --logout
        ;;
    *)
        ;;
esac

