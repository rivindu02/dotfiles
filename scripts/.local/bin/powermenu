#!/usr/bin/env bash

## Author : Aditya Shakya (adi1090x)
## Modified for Hyprland 

# Current Theme
dir="$HOME/.config/rofi/powermenu/type-1"
theme='style-1'

# CMDs
uptime="`uptime -p | sed -e 's/up //g'`"
host=`hostname`

# Options
shutdown='⏻ Shutdown'
reboot='󰓦 Reboot'
lock=' Lock'
suspend=' Suspend'
logout=' Logout'
yes=' Yes'
no=' No'

# Rofi CMD
rofi_cmd() {
    rofi -dmenu \
        -p "$(cat /etc/hostname)" \
        -mesg "Uptime: $uptime" \
        -theme ${dir}/${theme}.rasi \
        -no-auto-select
}

# Stay-awake state (see ~/.config/scripts/toggle-idle.sh)
stay_awake_pid="${XDG_RUNTIME_DIR:-/tmp}/stay-awake.pid"

# Confirmation CMD: $1 = message, $2 = window width
confirm_cmd() {
    rofi -theme-str "window {location: center; anchor: center; fullscreen: false; width: ${2:-250px};}" \
        -theme-str 'mainbox {children: [ "message", "listview" ];}' \
        -theme-str 'listview {columns: 2; lines: 1;}' \
        -theme-str 'element-text {horizontal-align: 0.5;}' \
        -theme-str 'textbox {horizontal-align: 0.5;}' \
        -dmenu \
        -p 'Confirmation' \
        -mesg "${1:-Are you Sure?}" \
        -no-auto-select \
        -theme ${dir}/${theme}.rasi
}

# Ask for confirmation. While stay-awake is on, say so: Yes turns it off first.
confirm_exit() {
    if [[ -f "$stay_awake_pid" ]]; then
        echo -e "$yes\n$no" | confirm_cmd '󰛊 Stay-awake is on (will turn off). Are you Sure?' 450px
    else
        echo -e "$yes\n$no" | confirm_cmd
    fi
}

# Pass variables to rofi dmenu
run_rofi() {
    echo -e "$lock\n$suspend\n$logout\n$reboot\n$shutdown" | rofi_cmd
}

# Execute Command
run_cmd() {
    selected="$(confirm_exit)"
    [[ "$selected" == "$yes" ]] || exit 0
    # Release the idle/sleep inhibitor, or suspend is refused
    [[ -f "$stay_awake_pid" ]] && "$HOME/.config/scripts/toggle-idle.sh"
    if [[ $1 == '--shutdown' ]]; then
        systemctl poweroff
    elif [[ $1 == '--reboot' ]]; then
        systemctl reboot
    elif [[ $1 == '--suspend' ]]; then
        systemctl suspend
    elif [[ $1 == '--logout' ]]; then
        hyprctl dispatch 'hl.dsp.exit()'
    fi
}

# Actions
chosen="$(run_rofi)"

[[ -z "$chosen" ]] && exit 0

case ${chosen} in
    "$shutdown")
        run_cmd --shutdown
        ;;
    "$reboot")
        run_cmd --reboot
        ;;
    "$lock")
        hyprlock
        ;;
    "$suspend")
        run_cmd --suspend
        ;;
    "$logout")
        run_cmd --logout
        ;;
    *)
        ;;
esac

