#!/bin/bash

source "$HOME/.config/rofi/scripts/toggle.sh"
rofi_toggle || exit 0

# ── Setup ────────────────────────────────────────────────────
# Define helper once at the top
dot() { [ "$current" = "$1" ] && echo "●" || echo "○"; }

is_asus() {
    local vendor
    vendor=$(tr '[:upper:]' '[:lower:]' < /sys/class/dmi/id/sys_vendor 2>/dev/null)
    [[ "$vendor" == *"asus"* ]] && command -v asusctl &>/dev/null
}

# ── Logic ────────────────────────────────────────────────────
menu_lines=3
if is_asus; then
    current=$(asusctl profile get | grep "Active profile" | awk '{print tolower($NF)}')

    quiet="󰾆  Quiet         $(dot quiet)"
    balanced="󰾅  Balanced      $(dot balanced)"
    performance="󰾇  Performance   $(dot performance)"

    charge_limit=$(asusctl battery info 2>/dev/null | sed -n 's/^Current battery charge limit: \([0-9][0-9]*\)%.*/\1/p')
    if [[ "$charge_limit" == 80 ]]; then
        next_charge_limit=100
        charge_status="On"
    else
        next_charge_limit=80
        charge_status="Off"
    fi
    [[ -z "$charge_limit" ]] && charge_status="Unknown"
    charge_toggle="󰂄  Limit to 80%: ${charge_status}"

    options=$(printf '%s\n' "$quiet" "$balanced" "$performance" "$charge_toggle")
    menu_lines=4
else
    # Check governor without sudo
    current=$(cat /sys/devices/system/cpu/cpu0/cpufreq/scaling_governor 2>/dev/null)
    
    # Check if a 'force' file exists to determine if we are in Auto mode 
    # (auto-cpufreq usually clears this file when in --edit or --reset mode)
    if [ -f /var/lib/auto-cpufreq/force_state ]; then
        auto_tick="☐"
    else
        auto_tick="☑"
    fi

    powersaver="󰾆  Power Saver   $(dot powersave)"
    performance="󰾇  Performance   $(dot performance)"
    auto_mode="󰾅  Auto (daemon)  ${auto_tick}"

    options=$(printf '%s\n' "$powersaver" "$performance" "$auto_mode")
fi

# ── UI ───────────────────────────────────────────────────────
chosen=$(echo -e "$options" | rofi -dmenu -i -p "Power" -no-custom -no-fixed-num-lines \
            -theme ~/.config/rofi/powermenu/type-1/style-1.rasi \
            -theme-str "listview { lines: ${menu_lines}; } entry { placeholder: \"Filter power options…\"; }" \
            -no-auto-select)

[[ -z "$chosen" ]] && exit 0

# ── Action ───────────────────────────────────────────────────
if is_asus; then
    case "$chosen" in
        *Limit\ to\ 80%:*)
            if asusctl battery limit "$next_charge_limit"; then
                notify-send "Battery Charge Limit" "Set to ${next_charge_limit}%" -t 2000
            else
                notify-send -u critical "Battery Charge Limit" "Failed to set charge limit to ${next_charge_limit}%" -t 4000
                exit 1
            fi
            exit 0
            ;;
        *Quiet*)       asusctl profile set Quiet ;;
        *Balanced*)    asusctl profile set Balanced ;;
        *Performance*) asusctl profile set Performance ;;
    esac
    notify-send "Power Profile" "Switched to ${chosen%% *}" -t 2000
else
    case "$chosen" in
        *Power\ Saver*) pkexec auto-cpufreq --force=powersave ;;
        *Performance*)  pkexec auto-cpufreq --force=performance ;;
        *Auto*)         pkexec auto-cpufreq --force=reset ;;
    esac
    notify-send "Power Profile" "Applied ${chosen%% *}" -t 2000
fi
