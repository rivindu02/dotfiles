# openclaude profile
.openclaude-profile.json
.config/gh/hosts.yml
.config/gcalcli

# Nvim undo history
.config/nvim/undo/**


# Nvim swap/backup files
*.swp
*.swo
*~

# Nvim shada (session data)
.local/share/nvim/

# SSH keys (safety net)
# Patterns containing "/" are anchored to the repo root, so the stow
# package path ssh/.ssh/ must be listed explicitly
.ssh/*.pem
.ssh/id_*
.ssh/known_hosts
.ssh/config
ssh/.ssh/config
ssh/.ssh/*.pem
ssh/.ssh/id_*
ssh/.ssh/known_hosts*

# aider session history (can capture pasted secrets/code)
.aider*

# Local security audit (lists where secrets live)
AUDIT.md

# Secrets
.secrets/

# Thumbnails / cache
.cache/

# OS junk
.DS_Store
Thumbs.db

# GTK4 symlinks (point to system theme, not yours)
.config/gtk-4.0/assets
.config/gtk-4.0/gtk.css
.config/gtk-3.0/assets
.config/gtk-3.0/gtk.css

# nwg-displays active profile (runtime state, not config)
.config/nwg-displays/active_profile.json

# waypaper (runtime wallpaper state)
.config/waypaper/

# Thunar (runtime/GUI generated)
.config/Thunar/

# VLC (bloated auto-generated config)
.config/vlc/

# monitors
.config/hypr/monitors.cofig
